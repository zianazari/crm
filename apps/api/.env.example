# Copy to .env for local development. Values match docker-compose.yml (dev only).
# Never put staging or production credentials in this file or anywhere in the repo.
CRM_ENVIRONMENT=development
CRM_DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
CRM_REDIS_URL=redis://localhost:6379/0
CRM_RABBITMQ_URL=amqp://crm:crm@localhost:5672/
# Local http only. Must stay true (the default) anywhere served over https.
CRM_COOKIE_SECURE=false
# Staging/production must set long random values (min. 32 chars); dev uses built-in placeholders.
# CRM_JWT_SECRET=
# CRM_OTP_SECRET=
