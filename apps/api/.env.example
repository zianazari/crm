# Copy to .env for local development. Values match docker-compose.yml (dev only).
# Never put staging or production credentials in this file or anywhere in the repo.
CRM_ENVIRONMENT=development
CRM_DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
CRM_REDIS_URL=redis://localhost:6379/0
CRM_RABBITMQ_URL=amqp://crm:crm@127.0.0.1:5672/
# Messaging: "queue" sends through the outbox, RabbitMQ and the worker
# (run: uv run python -m app.worker). "console" prints OTP codes to this log instead.
CRM_MESSAGING_MODE=queue
# Local test services from docker-compose: sms-sink (http://localhost:8030) and
# Mailpit (http://localhost:8025). Nothing is really sent.
CRM_SMS_SINK_URL=http://localhost:8030
CRM_SMS_CALLBACK_URL=http://host.docker.internal:8000/webhooks/sms
CRM_SMTP_HOST=localhost
CRM_SMTP_PORT=1025
# Local http only. Must stay true (the default) anywhere served over https.
CRM_COOKIE_SECURE=false
# Staging/production must set long random values (min. 32 chars); dev uses built-in placeholders.
# CRM_JWT_SECRET=
# CRM_OTP_SECRET=
